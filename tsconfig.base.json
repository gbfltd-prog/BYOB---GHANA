{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "declaration": true,
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "baseUrl": "./",
    "paths": {
      "@byob/types": ["packages/types/src/index.ts"],
      "@byob/prisma": ["packages/prisma/src/index.ts"],
      "@byob/prisma/*": ["packages/prisma/src/*"],
      "@byob/nest-common": ["packages/nest-common/src/index.ts"]
    }
  },
  "include": ["packages", "apps", "scripts"],
  "exclude": ["node_modules", "dist"]
}
