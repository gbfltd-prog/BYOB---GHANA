{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@byob/types": ["packages/types/src/index.ts"],
      "@byob/db": ["packages/db/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
