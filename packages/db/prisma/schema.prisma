generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  SUPERVISOR
  AGENT
  MANUFACTURER
}

enum OrderStatus {
  PENDING
  ASSIGNED
  CONFIRMED
  CANCELLED
}

enum MessageType {
  TEXT
  VOICE
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  role               UserRole            @default(AGENT)
  ghanaCardNumber    String              @unique
  accountNo          String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  agentProfile       AgentProfile?
  manufacturerProfile ManufacturerProfile?
  wallet             Wallet?
  conversationsAsAgent Conversation[]    @relation("AgentConversations")
  conversationsAsCustomer Conversation[] @relation("CustomerConversations")
  employabilityScores EmployabilityScore[]
  auditLogs          AuditLog[]
  // Orders created by this agent
  ordersAsAgent      Order[]             @relation("AgentOrders")
  // Agents supervised by this user (if role is SUPERVISOR)
  supervisedAgents   AgentProfile[]      @relation("SupervisorAgents")
}

model AgentProfile {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String   @unique
  supervisorId  String?
  supervisor    User?    @relation("SupervisorAgents", fields: [supervisorId], references: [id])
  storefrontColor String? // hex color
  storefrontBannerUrl String?
  storefrontSlogan String?
}

model ManufacturerProfile {
  id           String @id @default(uuid())
  user         User   @relation(fields: [userId], references: [id])
  userId       String @unique
  businessName String
  products     Product[]
}

model Wallet {
  id        String      @id @default(uuid())
  user      User        @relation(fields: [userId], references: [id])
  userId    String      @unique
  balance   Decimal     @db.Decimal(12, 2)
  txns      WalletTxn[]
  payoutRequests PayoutRequest[]
}

model WalletTxn {
  id         String   @id @default(uuid())
  wallet     Wallet   @relation(fields: [walletId], references: [id])
  walletId   String
  createdAt  DateTime @default(now())
  amount     Decimal  @db.Decimal(12, 2)
  type       String
  note       String?
}

model PayoutRequest {
  id         String       @id @default(uuid())
  wallet     Wallet       @relation(fields: [walletId], references: [id])
  walletId   String
  amount     Decimal      @db.Decimal(12, 2)
  status     PayoutStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  approvedBy String?
}

model Product {
  id          String            @id @default(uuid())
  manufacturer ManufacturerProfile @relation(fields: [manufacturerId], references: [id])
  manufacturerId String
  title       String
  description String
  price       Decimal           @db.Decimal(12, 2)
  commission  Json
  images      ProductImage[]
  inventory   Inventory[]
  orderItems  OrderItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ProductImage {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  url       String
}

model Warehouse {
  id        String     @id @default(uuid())
  name      String
  latitude  Float
  longitude Float
  inventory Inventory[]
  orders    Order[]
}

model Inventory {
  id          String   @id @default(uuid())
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId String
  product     Product   @relation(fields: [productId], references: [id])
  productId   String
  quantity    Int
  reserved    Int       @default(0)
}

model Conversation {
  id          String   @id @default(uuid())
  agent       User     @relation("AgentConversations", fields: [agentId], references: [id])
  agentId     String
  customer    User?    @relation("CustomerConversations", fields: [customerId], references: [id])
  customerId  String?
  createdAt   DateTime @default(now())
  messages    Message[]
  employabilityScores EmployabilityScore[]
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  senderId       String
  content        String
  type           MessageType  @default(TEXT)
  createdAt      DateTime     @default(now())
}

model EmployabilityScore {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  conversation  Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  communication Float
  problemSolving Float
  professionalism Float
  digitalFluency Float
  teamwork      Float
  weightedScore Float
  certificateUrl String?
  createdAt     DateTime @default(now())
}

model Order {
  id          String      @id @default(uuid())
  agent       User        @relation("AgentOrders", fields: [agentId], references: [id])
  agentId     String
  customerId  String?
  status      OrderStatus @default(PENDING)
  warehouse   Warehouse?  @relation(fields: [warehouseId], references: [id])
  warehouseId String?
  items       OrderItem[]
  subtotal    Decimal     @db.Decimal(12, 2)
  commission  Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
}

model OrderItem {
  id        String   @id @default(uuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)
}

model AuditLog {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
}
