generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  AGENT
  MANUFACTURER
  CUSTOMER
}

enum MessageType {
  TEXT
  VOICE
}

enum OrderStatus {
  PENDING
  ASSIGNED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum WalletTxnType {
  COMMISSION
  TRANSFER
  PAYOUT
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  passwordHash     String
  role             UserRole
  ghanaCardNumber  String              @unique
  accountNo        String              @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  agentProfile     AgentProfile?
  manufacturer     ManufacturerProfile?
  wallet           Wallet?
  messages         Message[]
  agentConversations Conversation[]    @relation("AgentConversation")
  supervisedAgents  AgentProfile[]     @relation("SupervisorAgents")
  createdOrders    Order[]             @relation("AgentOrders")
  payoutRequests   PayoutRequest[]     @relation("PayoutCreator")
  auditLogs        AuditLog[]
}

model AgentProfile {
  id                 String        @id @default(cuid())
  user               User          @relation(fields: [userId], references: [id])
  userId             String        @unique
  supervisor         User?         @relation("SupervisorAgents", fields: [supervisorId], references: [id])
  supervisorId       String?
  storefrontTheme    Json?
  slogan             String?
  totalCommission    Decimal        @default(0)
  employabilityScore EmployabilityScore[]
}

model ManufacturerProfile {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String    @unique
  businessName String
  description  String?
  verified     Boolean   @default(false)
  products     Product[]
}

model Product {
  id                String            @id @default(cuid())
  manufacturer      ManufacturerProfile @relation(fields: [manufacturerId], references: [id])
  manufacturerId    String
  title             String
  description       String
  price             Decimal            @db.Decimal(12, 2)
  commissionScheme  CommissionScheme?
  images            ProductImage[]
  inventories       Inventory[]
  orderItems        OrderItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model ProductImage {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  url        String
  watermark  String?
}

model CommissionScheme {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String   @unique
  rules      Json
}

model Warehouse {
  id         String      @id @default(cuid())
  name       String
  city       String
  latitude   Float
  longitude  Float
  inventory  Inventory[]
  orders     Order[]
}

model Inventory {
  id          String    @id @default(cuid())
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId String
  product     Product   @relation(fields: [productId], references: [id])
  productId   String
  quantity    Int       @default(0)
}

model Conversation {
  id            String    @id @default(cuid())
  agent         User      @relation("AgentConversation", fields: [agentId], references: [id])
  agentId       String
  customerId    String?
  customerAlias String?
  createdAt     DateTime  @default(now())
  messages      Message[]
  employabilityEvents EmployabilityScore[]
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  sender         User?        @relation(fields: [senderId], references: [id])
  senderId       String?
  content        String
  messageType    MessageType  @default(TEXT)
  metadata       Json?
  createdAt      DateTime     @default(now())
}

model EmployabilityScore {
  id               String       @id @default(cuid())
  conversation     Conversation @relation(fields: [conversationId], references: [id])
  conversationId   String
  agent            AgentProfile @relation(fields: [agentId], references: [id])
  agentId          String
  communication    Float
  problemSolving   Float
  professionalism  Float
  digitalFluency   Float
  teamwork         Float
  weightedScore    Float
  certificateUrl   String?
  createdAt        DateTime     @default(now())
}

model Order {
  id               String      @id @default(cuid())
  agent            User        @relation("AgentOrders", fields: [agentId], references: [id])
  agentId          String
  customerName     String
  customerPhone    String
  latitude         Float
  longitude        Float
  warehouse        Warehouse?  @relation(fields: [warehouseId], references: [id])
  warehouseId      String?
  total            Decimal     @db.Decimal(12, 2)
  commissionTotal  Decimal     @db.Decimal(12, 2)
  status           OrderStatus @default(PENDING)
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model OrderItem {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  price      Decimal  @db.Decimal(12, 2)
  commission Decimal  @db.Decimal(12, 2)
}

model Wallet {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id])
  userId    String       @unique
  balance   Decimal      @db.Decimal(12, 2) @default(0)
  txns      WalletTxn[]
  payouts   PayoutRequest[]
}

model WalletTxn {
  id        String        @id @default(cuid())
  wallet    Wallet        @relation(fields: [walletId], references: [id])
  walletId  String
  amount    Decimal       @db.Decimal(12, 2)
  type      WalletTxnType
  metadata  Json?
  createdAt DateTime      @default(now())
}

model PayoutRequest {
  id            String       @id @default(cuid())
  wallet        Wallet       @relation(fields: [walletId], references: [id])
  walletId      String
  amount        Decimal      @db.Decimal(12, 2)
  status        PayoutStatus @default(REQUESTED)
  requiresSuper Boolean      @default(false)
  createdByUser User         @relation("PayoutCreator", fields: [createdBy], references: [id])
  createdBy     String
  approvedBy    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id])
  actorId   String?
  action    String
  entity    String
  metadata  Json?
  createdAt DateTime @default(now())
}
